{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Depurar con Live Server",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "url": "http://127.0.0.1:5500", // <-- Dirección por defecto de Live Server
            "webRoot": "${workspaceFolder}",
            "pathMappings": [
                {
                    "url": "http://127.0.0.1:5500",
                    "path": "${workspaceFolder}"
                }
            ]
        }
    ]
}